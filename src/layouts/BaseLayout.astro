---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}

const {
  title = "小行星 AI 观测站",
  description = "从噪声中寻找真正改变 AI 工程与产品方向的信号。",
  image,
  type = "website"
} = Astro.props;
const pageTitle = title === "小行星 AI 观测站" ? title : `${title}｜小行星 AI 观测站`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(image, Astro.site) : undefined;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="小行星 AI 观测站" href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="小行星 AI 观测站首页">
          <span class="brand-mark" aria-hidden="true"></span>
          <span><span class="brand-name">小行星 AI 观测站</span><span class="brand-sub">ASTEROID AI OBSERVATORY</span></span>
        </a>
        <nav class="nav" aria-label="主导航">
          <a href="/weekly/">周报</a>
          <a href="/stories/">专题</a>
          <a href="/daily/">日报</a>
          <a href="/archive/">归档</a>
          <a class="search-link" href="/search/">搜索</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <div class="kicker">END OF TRANSMISSION</div>
          <div class="footer-title">持续观测，保持判断。</div>
        </div>
        <div class="footer-meta">
          <p>小行星 AI 观测站 · 视频之外的完整信号档案</p>
          <p><a href="/rss.xml">RSS 订阅</a> · <a href="/archive/">全部归档</a></p>
          <p>© {new Date().getFullYear()} Asteroid AI Observatory</p>
        </div>
      </div>
    </footer>
  </body>
</html>

---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleListing from "../../components/ArticleListing.astro";
import { byNewest } from "../../lib/content";
import { topicSectionId, topicSectionPath, topicSections } from "../../lib/topicSections";
const articles = (await getCollection("articles", ({ data }) => data.kind === "topic" && !data.draft)).sort(byNewest);
const groups = topicSections.map((section) => ({
  ...section,
  articles: articles.filter((article) => topicSectionId(article) === section.id)
}));
---
<BaseLayout title="专题深解读" description="围绕 AI 工程、产品与组织变化进行有证据的专题拆解。">
  <header class="listing-header"><div class="shell"><div class="kicker">DEEP DIVE / FIELD REPORT</div><h1>专题深解读</h1><p>{articles.length} 篇专题按阅读目的分成六条主线。先选择你要解决的问题，再进入对应的技术、案例和选型资料。</p></div></header>
  <nav class="shell topic-section-grid" aria-label="专题分类">
    {groups.map((group, index) => (
      <a class="topic-section-card" href={topicSectionPath(group.id)}>
        <span class="topic-section-number">0{index + 1}</span>
        <span class="kicker">{group.index}</span>
        <strong>{group.label}</strong>
        <span>{group.description}</span>
        <small>{group.articles.length} 篇专题 →</small>
      </a>
    ))}
  </nav>
  <div class="shell topic-section-list">
    {groups.map((group) => (
      <section id={group.id} class="topic-section-block">
        <div class="section-head">
          <div><div class="kicker">{group.index}</div><h2>{group.label}</h2><p>{group.description}</p></div>
          <a href={topicSectionPath(group.id)}>查看全部 {group.articles.length} 篇 →</a>
        </div>
        <ArticleListing articles={group.articles.slice(0, 3)} />
      </section>
    ))}
  </div>
</BaseLayout>
